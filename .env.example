# ============================================
# Twilio Credentials (REQUIRED for live mode)
# ============================================
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Supabase server-side mirror (never expose or commit the Secret key)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...

# Email is independent of Twilio and is disabled unless explicitly run live.
# EMAIL_FROM=zeybrowwax@gmail.com
# EMAIL_FROM_NAME=Zey Brow & Wax
# EMAIL_LOGO_URL=https://approved-image-host.example/zeybrow-logo.png
# GMAIL_CLIENT_ID=...
# GMAIL_CLIENT_SECRET=...
# GMAIL_REFRESH_TOKEN=...
# EMAIL_LIVE_APPROVED=true

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO

# ============================================
# OPTIONAL OVERRIDES
# ============================================
# The settings below can override config.yml settings if needed.
# Leave commented to use config.yml values.

# Override dry run mode
# DRY_RUN=false

# Override test phone numbers (comma-separated)
# TEST_PHONE_NUMBERS=+14155551234,+14155551235

# Override phone number column name
# PHONE_NUMBER_COLUMN=phone_number

# Override file names
# CUSTOMERS_LIST_OLD=customers_list_old.xlsx
# CUSTOMERS_LIST_NEW=customers_list_new.xlsx
# CAMPAIGN_CONFIG=campaigns.xlsx

# Vagaro webhook receiver (binds to loopback for Cloudflare Tunnel)
# VAGARO_WEBHOOK_HOST=127.0.0.1
# VAGARO_WEBHOOK_PORT=8787
# VAGARO_WEBHOOK_PATH=/vagaro/webhook
# Set this only after creating the Vagaro webhook and viewing its verification token.
# VAGARO_WEBHOOK_TOKEN=keep-this-out-of-git-and-chat
