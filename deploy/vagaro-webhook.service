[Unit]
Description=Zey Batch Vagaro webhook receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes
WorkingDirectory=/opt/data/zey_batch
EnvironmentFile=-/opt/data/zey_batch/.env
ExecStart=/usr/local/bin/uv run python scripts/vagaro_webhook.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
